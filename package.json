{
  "name": "orchtopus",
  "version": "0.0.0",
  "private": true,
  "description": "Windows desktop app that runs and supervises several Claude Code sessions.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "npm run build && playwright test",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "smoke:native": "electron scripts/smoke-native.js",
    "package": "npm run build && electron-builder --dir",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.9",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lucide-react": "1.77.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "zustand": "5.1.0"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "node-pty": "1.1.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  }
}
