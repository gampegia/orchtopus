{
  "description": "Classic plugin hooks (no hooks module): PreToolUse allow for gh pr create, PermissionRequest allow for node -e",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/allow.mjs\" pre" }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/allow.mjs\" perm" }
        ]
      }
    ]
  }
}
